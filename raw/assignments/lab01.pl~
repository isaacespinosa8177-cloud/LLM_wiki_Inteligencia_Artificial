mother(M, C) :-
    parent(M, C),
    female(M).

sibling(X, Y) :-
    parent(P, X),
    parent(P, Y),
    X \= Y.

sister(S, P) :-
    parent(M, S),
    parent(M, P),
    S \= P,
    female(S).

grandmother(G, C) :-
    parent(G, P),
    parent(P, C),
    female(G).

uncle(U, N) :-
    parent(P, N),
    parent(G, P),
    parent(G, U),
    U \= P,
    male(U).

cousin(C1, C2) :-
    parent(P1, C1),
    parent(P2, C2),
    parent(G, P1),
    parent(G, P2),
    P1 \= P2,
    C1 \= C2.

father_in_law(F, P) :-
    spouse(P, S),
    parent(F, S),
    male(F).

father(F, C) :-
    parent(F, C),
    male(F).

brother(B, P) :-
    parent(M, B),
    parent(M, P),
    B \= P,
    male(B).

descendant(D, A) :-
    parent(A, D).

descendant(D, A) :-
    parent(A, P),
    descendant(D, P).


